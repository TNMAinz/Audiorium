{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AUDIORIUM",
  "version": "2.6.9",
  "identifier": "app.audiorium.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AUDIORIUM",
        "decorations": false,
        "visible": false,
        "width": 1440,
        "height": 860,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "publisher": "AUDIORIUM",
    "copyright": "© 2026 AUDIORIUM",
    "shortDescription": "Audio workstation: library playback, processors, equaliser, spatial field and a polyphonic synth.",
    "longDescription": "AUDIORIUM plays local music through its own signal chain, shows what the engine is measuring, and includes a wavetable synth with a 536-pack preset library.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "bannerPath": "wix/banner.bmp",
        "dialogImagePath": "wix/dialog.bmp"
      },
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File sign.ps1 %1"
    }
  }
}
