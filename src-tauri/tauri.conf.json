{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AUDIORIUM",
  "version": "1.2.2",
  "identifier": "app.audiorium.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "AUDIORIUM",
      "decorations": false,
      "visible": false,
      "width": 1440,
      "height": 860,
      "minWidth": 760,
      "minHeight": 600
    }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File sign.ps1 %1"
    }
  }
}
